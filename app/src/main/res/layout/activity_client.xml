<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="client.ClientActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_client"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextColor="@android:color/white"></com.google.android.material.appbar.MaterialToolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_client">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar_client">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="32dp"
                android:minHeight="80dp"
                app:cardBackgroundColor="#cdcdcd"
                app:cardCornerRadius="10dp"
                app:cardElevation="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <TableRow android:id="@+id/manufacturer_row">

                        <com.google.android.material.textview.MaterialTextView
                            android:fontFamily="sans-serif-condensed"
                            android:text="Manufacturer"
                            android:textColor="@android:color/black" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp"
                            android:text=":"
                            android:textColor="@android:color/black" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/manufacturer"
                            android:fontFamily="sans-serif-condensed"
                            android:text="Android"
                            android:textColor="@android:color/black" />
                    </TableRow>

                    <TableRow android:id="@+id/modelid_row">

                        <com.google.android.material.textview.MaterialTextView
                            android:fontFamily="sans-serif-condensed"
                            android:text="Model"
                            android:textColor="@android:color/black" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp"
                            android:text=":"
                            android:textColor="@android:color/black" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/model_id"
                            android:fontFamily="sans-serif-condensed"
                            android:text="AndroidFaceCamera"
                            android:textColor="@android:color/black" />
                    </TableRow>

                    <TableRow
                        android:id="@+id/device_id_row"
                        android:visibility="gone">

                        <com.google.android.material.textview.MaterialTextView
                            android:fontFamily="sans-serif-condensed"
                            android:text="Device ID"
                            android:textColor="@android:color/black" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp"
                            android:text=":"
                            android:textColor="@android:color/black" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/device_id"
                            android:fontFamily="sans-serif-condensed"
                            android:text=""
                            android:textColor="@android:color/black" />
                    </TableRow>

                    <TableRow android:id="@+id/device_status_row">

                        <com.google.android.material.textview.MaterialTextView
                            android:fontFamily="sans-serif-condensed"
                            android:text="Device status"
                            android:textColor="@android:color/black" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp"
                            android:text=":"
                            android:textColor="@android:color/black" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/device_status"
                            android:fontFamily="sans-serif-condensed"
                            android:text="Not Ready"
                            android:textColor="@android:color/black" />
                    </TableRow>
                </TableLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/settingBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="openSettings"
                android:text="@string/settings"
                app:layout_constraintBottom_toTopOf="@+id/card2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.498"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/card"
                app:layout_constraintVertical_bias="0.289" />

            <Button
                android:id="@+id/validate_cert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="askPermissionAndValidateCertificates"
                android:text="@string/load_and_validate_certificates"
                app:layout_constraintBottom_toTopOf="@+id/card2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.498"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/settingBtn"
                app:layout_constraintVertical_bias="0.736" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card2"
                android:layout_width="367dp"
                android:layout_height="291dp"
                android:layout_margin="16dp"
                android:elevation="5dp"
                app:cardCornerRadius="10dp"
                app:layout_constraintBottom_toTopOf="@id/action_table"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/empty_layout"
                    android:layout_width="367dp"
                    android:layout_height="291dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="visible">

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/client_progress_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/client_progress_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/response_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:visibility="gone">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/response_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="Response : "
                        android:textColor="@color/design_default_color_on_secondary"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageButton
                        android:id="@+id/share_response"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="10dp"
                        android:background="#0000"
                        android:src="@drawable/ic_baseline_share_24"
                        android:text="share"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/primary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/textbox"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:padding="8dp"
                        android:scrollbars="vertical"
                        android:textColor="@color/design_default_color_on_secondary"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/share_response" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <TableLayout
                android:id="@+id/action_table"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@id/logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/card2">

                <TableRow
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/discover"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:width="150dp"
                        android:text="@string/discover" />
                </TableRow>

                <TableRow
                    android:id="@+id/device_type_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:layout_marginHorizontal="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/custom_border"
                    android:gravity="center_horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:visibility="gone">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="12dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/device_type"
                        android:textColor="@android:color/black" />

                    <Spinner
                        android:id="@+id/device_type_spinner"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content" />
                </TableRow>

                <TableRow
                    android:id="@+id/timeout_score_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_span="2"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:fontFamily="sans-serif-condensed"
                            android:text="Timeout (s)"
                            android:textColor="@android:color/black" />

                        <EditText
                            android:id="@+id/timeout_input"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="16dp"
                            android:minWidth="56dp"
                            android:inputType="number"
                            android:text="60" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:fontFamily="sans-serif-condensed"
                            android:text="Score"
                            android:textColor="@android:color/black" />

                        <EditText
                            android:id="@+id/score_input"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="56dp"
                            android:inputType="number"
                            android:text="30" />
                    </LinearLayout>
                </TableRow>

                <TableRow
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:width="150dp"
                        android:enabled="false"
                        android:text="@string/info" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/capture"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:width="150dp"
                        android:enabled="false"
                        android:text="@string/capture" />
                </TableRow>

            </TableLayout>

            <ImageView
                android:id="@+id/logo"
                android:layout_width="128dp"
                android:layout_height="64dp"
                android:layout_marginBottom="20dp"
                android:src="@drawable/app_icon"
                app:layout_constraintBottom_toTopOf="@id/link_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/link_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp"
                android:textColor="@color/primary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
