<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="client.KeyCredentialFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/custom_border"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/key_label_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/key_label"
            android:textAlignment="center"
            android:textColor="@color/primary"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/key_status_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/key_status_not_provisioned"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/key_issued_on_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/key_expires_on_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />

    </LinearLayout>

</FrameLayout>
